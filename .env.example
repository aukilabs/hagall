# Set these to your running DDS and DMS services. DMS includes the /v1 base path.
RELAY_DDS_URL=http://localhost:8080
RELAY_DDS_PUBLIC_KEY_URL=http://localhost:8080/service/p2p-verification-keys
RELAY_DMS_URL=http://localhost:8081/v1
RELAY_LOCAL_TEST_ALLOW_HTTP=true

# Local-test identity files, each with mode 0600. Keep secret values out of .env.
RELAY_REGISTRATION_CREDENTIALS_FILE=./.local/registration.txt
RELAY_WALLET_PRIVATE_KEY_FILE=./.local/wallet.key
RELAY_LIBP2P_PRIVATE_KEY_FILE=./.local/libp2p.key

# Replace hostname and Peer ID. DNS must reach this relay; WSS needs TLS proxying.
RELAY_PUBLIC_BASE_MULTIADDRS='/dns4/relay.your-domain.com/tcp/4001/p2p/<relay-peer-id>,/dns4/relay.your-domain.com/tcp/443/wss/p2p/<relay-peer-id>'
RELAY_TCP_LISTEN_MULTIADDR=/ip4/127.0.0.1/tcp/4001
RELAY_WS_LISTEN_MULTIADDR=/ip4/127.0.0.1/tcp/4002/ws
RELAY_ADMIN_ADDR=127.0.0.1:9090
RELAY_METRICS_ADDR=127.0.0.1:9091

# Enable after checking the advertised addresses. This gate requires a restart.
RELAY_ACCEPT_BOOKINGS=false
# Short drain for local runs; must be shorter than DMS's live recovery grace.
RELAY_SHUTDOWN_DRAIN=5s

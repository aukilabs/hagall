{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fullnameOverride",
    "replicaCount",
    "image",
    "identity",
    "relay",
    "service",
    "resources",
    "podMonitor"
  ],
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "maxLength": 52,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "tag",
        "digest",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret"
      ],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ddsUrl",
        "ddsPublicKeyUrl",
        "dmsUrl",
        "publicHost",
        "peerId",
        "capacity",
        "acceptBookings",
        "admissionTTL",
        "authConcurrency",
        "authAttemptsPerIP",
        "authAttemptsPerPeer",
        "shutdownDrainSeconds"
      ],
      "properties": {
        "ddsUrl": {
          "type": "string",
          "pattern": "^https://.+"
        },
        "ddsPublicKeyUrl": {
          "type": "string",
          "pattern": "^https://.+"
        },
        "dmsUrl": {
          "type": "string",
          "pattern": "^https://.+"
        },
        "publicHost": {
          "type": "string",
          "minLength": 1
        },
        "peerId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[1-9A-HJ-NP-Za-km-z]+$"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "acceptBookings": {
          "type": "boolean"
        },
        "admissionTTL": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s)$"
        },
        "authConcurrency": {
          "type": "integer",
          "minimum": 1
        },
        "authAttemptsPerIP": {
          "type": "integer",
          "minimum": 1
        },
        "authAttemptsPerPeer": {
          "type": "integer",
          "minimum": 1
        },
        "shutdownDrainSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public"
      ],
      "properties": {
        "public": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "subnetIds",
            "certificateArn",
            "tcpPort",
            "websocketPort"
          ],
          "properties": {
            "subnetIds": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^subnet-[a-f0-9]+$"
              }
            },
            "certificateArn": {
              "type": "string",
              "pattern": "^arn:aws:acm:[a-z0-9-]+:[0-9]{12}:certificate/[a-f0-9-]+$"
            },
            "tcpPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "websocketPort": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "resources": {
      "type": "object"
    },
    "podMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "namespace",
        "interval"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "interval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(ms|s|m)$"
        }
      }
    }
  }
}
